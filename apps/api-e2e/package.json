{
  "name": "@friend-workspace/api-e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "implicitDependencies": [
      "@friend-workspace/api"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
